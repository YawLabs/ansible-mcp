{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.5.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ansible-lint",
          "version": "26.10.1",
          "informationUri": "https://github.com/ansible/ansible-lint",
          "rules": [
            {
              "id": "yaml[truthy]",
              "name": "yaml[truthy]",
              "shortDescription": { "text": "Truthy value should be one of [false, true]" },
              "defaultConfiguration": { "level": "warning" },
              "help": { "text": "" },
              "helpUri": "https://docs.ansible.com/projects/lint/rules/yaml/",
              "properties": { "tags": ["formatting", "yaml"] }
            },
            {
              "id": "no-free-form",
              "name": "no-free-form",
              "shortDescription": { "text": "Avoid using free-form when calling module actions. (ufw)" },
              "defaultConfiguration": { "level": "warning" },
              "help": { "text": "Avoid free-form inside files as it can produce subtle bugs." },
              "helpUri": "https://docs.ansible.com/projects/lint/rules/no-free-form/",
              "properties": { "tags": ["syntax", "risk"] }
            },
            {
              "id": "fqcn[action]",
              "name": "fqcn[action]",
              "shortDescription": { "text": "Use FQCN for module actions, such `community.general.ufw`." },
              "defaultConfiguration": { "level": "warning" },
              "help": { "text": "Check whether actions are using using full qualified collection names." },
              "helpUri": "https://docs.ansible.com/projects/lint/rules/fqcn/",
              "properties": { "tags": ["formatting"] }
            }
          ]
        }
      },
      "columnKind": "utf16CodeUnits",
      "results": [
        {
          "ruleId": "yaml[truthy]",
          "level": "error",
          "message": { "text": "Truthy value should be one of [false, true]" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "roles/webapp/meta/argument_specs.yml", "uriBaseId": "SRCROOT" },
                "region": { "startLine": 19 }
              }
            }
          ]
        },
        {
          "ruleId": "no-free-form",
          "level": "error",
          "message": { "text": "ufw" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "roles/webapp/tasks/main.yml", "uriBaseId": "SRCROOT" },
                "region": { "startLine": 9 }
              }
            }
          ]
        },
        {
          "ruleId": "fqcn[action]",
          "level": "error",
          "message": { "text": "Action `ufw` is not FQCN." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "roles/webapp/tasks/main.yml", "uriBaseId": "SRCROOT" },
                "region": { "startLine": 10, "startColumn": 3 }
              }
            }
          ]
        }
      ],
      "originalUriBaseIds": { "SRCROOT": { "uri": "file:///tmp/ansible-mcp-work/project/" } }
    }
  ]
}
